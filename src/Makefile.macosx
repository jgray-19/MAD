# project
PRJ      := mad

# lua/mad modules to NOT embed
NOT      := # $(wildcard *.mad help/*.mad)

# setup
# Use a single native toolchain for the executable and the static libraries.
# Do not replace a compiler selected in the environment or on the make command
# line.  GNU make defines CC=cc by default, so '?=' would not do that.
ifeq ($(origin CC), default)
CC := $(or $(firstword $(wildcard /opt/homebrew/bin/gcc-[0-9]*)),gcc)
endif
ifeq ($(origin CXX), default)
CXX := $(or $(firstword $(wildcard /opt/homebrew/bin/g++-[0-9]*)),g++)
endif
ifeq ($(origin FC), default)
FC := gfortran
endif
DIR      := build
# MAD's checked-in lib directory contains build notes; dependency source trees
# are normally supplied with LIB or MAD_DEPS.  Keep the local build location as
# a convenient default for a checkout rebuilt using lib/README.md.
LIB      ?= $(if $(MAD_DEPS),$(MAD_DEPS),../lib)
ifeq ($(wildcard $(LIB)/luajit/src/lua.h),)
ifneq ($(wildcard /private/tmp/mad-deps/luajit/src/lua.h),)
LIB      := /private/tmp/mad-deps
endif
endif
BIN      := ../bin/macosx
AR       := ar -ruv
LJ       := $(firstword $(wildcard ./mad $(LIB)/luajit/bin/luajit $(LIB)/luajit/src/luajit))
ARCH     := $(shell uname -m)
CPUFLAGS := $(if $(filter arm64 aarch64,$(ARCH)),-mcpu=native,-march=native -mtune=native)
FFTW_DIR := $(firstword $(wildcard $(LIB)/fftw3 $(LIB)/fftw-3.3.10))
NFFT_DIR := $(firstword $(wildcard $(LIB)/nfft3 $(LIB)/nfft-3.5.3))

# depend
DFLAGS   := -std=c11 -MM

# C
CFLAGS   := -std=c11 -W -Wall -Wextra -pedantic # -no-pie
CFLAGS   += -O3 -ftree-vectorize -fPIC -flto $(CPUFLAGS) #-fopt-info
CFLAGS   += -Waggregate-return -Wcast-align -Wdisabled-optimization \
						-Wpointer-arith -Wsign-compare -Wwrite-strings \
						-Wbad-function-cast -Wmissing-prototypes -Wnested-externs \
						-Wstrict-prototypes -Wunreachable-code -Wno-vla-parameter \
						$(CCOPTIONS) -fopenmp #-DDEBUG
# https://gcc.gnu.org/onlinedocs/gcc/Optimize-Options.html
# https://gcc.gnu.org/wiki/FloatingPointMath
CFLAGS   += -fno-math-errno

# C++
CXXFLAGS := -std=c++20 -W -Wall -Wextra -pedantic # -no-pie
CXXFLAGS += -O3 -ftree-vectorize -fPIC -flto $(CPUFLAGS) #-fopt-info
CXXFLAGS += -Wcast-align -Wdisabled-optimization \
						-Wpointer-arith -Wsign-compare -Wwrite-strings -Wunreachable-code \
						$(CXXOPTIONS) -fopenmp #-DDEBUG
# https://gcc.gnu.org/onlinedocs/gcc/Optimize-Options.html
# https://gcc.gnu.org/wiki/FloatingPointMath
CXXFLAGS += -fdiagnostics-all-candidates -fno-math-errno

# fortran
FFLAGS   := -std=f95 -W -Wall -Wextra -pedantic # -no-pie
FFLAGS   += -O3 -ftree-vectorize -fPIC -flto $(CPUFLAGS)

# lua/mad
LFLAGS   :=

# linker
# `-ld_classic` was removed by current Xcode toolchains.  The system linker
# handles arm64 Mach-O objects directly.
LDFLAGS  := -static-libgcc # disable ASLR: -Wl,-no_pie
LDFLAGS  += $(BIN)/liblpeg.a   $(BIN)/liblfs.a     $(BIN)/libluajit.a \
						$(BIN)/liblapack.a $(BIN)/librefblas.a \
						$(BIN)/libnfft3.a  $(BIN)/libfftw3.a   \
						$(BIN)/libnlopt.a \
						$(or $(wildcard $(shell $(CC) -print-file-name=libgfortran.a)),-lgfortran) \
						$(or $(wildcard $(shell $(CC) -print-file-name=libquadmath.a)),-lquadmath) \
						$(or $(wildcard $(shell $(CC) -print-file-name=libgomp.a))    ,-lgomp) \
						$(or $(wildcard $(shell $(CC) -print-file-name=libstdc++.a))  ,-lstdc++) \
						$(LDOPTIONS)

NATIVE_LIBS := $(BIN)/liblpeg.a   $(BIN)/liblfs.a     $(BIN)/libluajit.a \
               $(BIN)/liblapack.a $(BIN)/librefblas.a \
               $(BIN)/libnfft3.a  $(BIN)/libfftw3.a   $(BIN)/libnlopt.a

# The MADLibs submodule currently also carries Intel archives.  Never let an
# Apple Silicon build silently attempt to link them.
ifneq ($(filter arm64 aarch64,$(ARCH)),)
check-native-libs:
	@for lib in $(NATIVE_LIBS); do \
	  test -f $$lib || { echo "missing native dependency: $$lib"; exit 1; }; \
	  lipo -archs $$lib | grep -qw arm64 || { \
	    echo "$$lib is not an arm64 archive; rebuild it as described in ../lib/README.md"; exit 1; \
	  }; \
	done
else
check-native-libs:
	@:
endif

# files setup
# SSE/AVX intrinsics are x86-only.  ARM64 uses the portable implementations
# (and can still be auto-vectorised by the compiler).
SSESRC   := $(if $(filter arm64 aarch64,$(ARCH)),,$(wildcard sse/*.c))
ASRC     := $(wildcard *.lua *.mad help/*.mad *.c *.cpp *.f90) $(SSESRC) # all sources
RSRC     := $(filter-out $(NOT),$(ASRC))                               # skip sources
CSRC     := $(filter %.c,$(RSRC))                                      # .c   sources
CXXSRC   := $(filter %.cpp,$(RSRC))                                    # .cpp sources
FSRC     := $(filter %.f90,$(RSRC))                                    # .f90 sources
LSRC     := $(filter %.lua,$(RSRC))                                    # .lua sources
MSRC     := $(filter %.mad,$(RSRC))                                    # .mad sources

DEP      := $(patsubst %.c,%.d,$(filter-out mad_main.c,$(CSRC)))
DEP      += $(patsubst %.cpp,%.d,$(CXXSRC))
DEP      := $(addprefix $(DIR)/,$(DEP))

OBJ      := $(patsubst %.c,%.o,$(CSRC))
OBJ      += $(patsubst %.cpp,%.o,$(CXXSRC))
OBJ      += $(patsubst %.f90,%.o,$(FSRC))
OBJ      += $(patsubst %.lua,%.o,$(LSRC))
OBJ      += $(patsubst %.mad,%.o,$(MSRC))
OBJ      := $(addprefix $(DIR)/,$(OBJ))

DOIT     := $(shell mkdir -p $(DIR) $(DIR)/help $(DIR)/sse)

# files specific setup
$(DIR)/mad_main.o      : CFLAGS += -I$(LIB)/luajit/src
$(DIR)/mad_nlopt.o     : CFLAGS += -I$(LIB)/nlopt/src/api
$(DIR)/mad_fft.o       : CFLAGS += -I$(FFTW_DIR)/api -I$(NFFT_DIR)/include
$(DIR)/mad_ctpsa.o     : mad_tpsa.c
$(DIR)/mad_ctpsa_ops.o : mad_tpsa_ops.c
$(DIR)/mad_ctpsa_fun.o : mad_tpsa_fun.c
$(DIR)/mad_ctpsa_div.o : mad_tpsa_div.c
$(DIR)/mad_ctpsa_comp.o: mad_tpsa_comp.c
$(DIR)/mad_ctpsa_minv.o: mad_tpsa_minv.c
$(DIR)/mad_ctpsa_mops.o: mad_tpsa_mops.c
$(DIR)/mad_ctpsa_io.o  : mad_tpsa_io.c

# rules
$(PRJ): lib$(PRJ).a | check-native-libs check-luajit
	$(CC) $(CFLAGS) -o $@ -Wl,-force_load $< $(LDFLAGS)

lib$(PRJ).a: $(OBJ) | check-luajit
	$(AR) $@ $(OBJ)

check-luajit:
	@test -n "$(LJ)" && test -x "$(LJ)" || { \
	  echo "missing LuaJIT bytecode compiler; set LIB to the dependency source tree or install ./mad"; exit 1; \
	}

$(DIR)/%.o: %.mad
	$(LJ) $(LFLAGS) -bg $< $@

$(DIR)/%.o: %.lua
	$(LJ) $(LFLAGS) -bg $< $@

$(DIR)/%.o: %.f90
	$(FC) $(FFLAGS) -c $< -o $@

$(DIR)/%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

$(DIR)/%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(DIR)/%.d: %.c %.cpp
	$(CC) $(DFLAGS) $< > $@
	@sed -i.bak -e 's,\($*\)\.o[ :]*,$(DIR)/\1.o $@ : ,g' $@
	@rm $@.bak

.PHONY: libdep clean cleanbin cleanobj check-native-libs check-luajit

libdep:
	otool -L $(PRJ)

cleanbin:
	rm -f $(PRJ)

cleanobj:
	rm -rf $(DIR)
	rm -rf lib$(PRJ).a

clean: cleanbin cleanobj

# default rule
.DEFAULT_GOAL := $(PRJ)

# include dependencies
BUILDGOALS := $(PRJ) lib$(PRJ).a
ifneq ($(filter $(BUILDGOALS),$(MAKECMDGOALS)),)
-include $(DEP)
endif
ifeq ($(MAKECMDGOALS),)
-include $(DEP)
endif
